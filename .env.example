# NBA Betting Model - Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# REQUIRED VARIABLES (MUST SET FOR PRODUCTION)
# ============================================================================

# Balldontlie API Key (GOAT tier for live odds and stats)
# Get yours at: https://balldontlie.io
BALLDONTLIE_API_KEY=your_balldontlie_api_key_here

# PostgreSQL Database URL (auto-provisioned by Railway)
# Format: postgresql://user:password@host:port/database
# Railway automatically sets this when you provision PostgreSQL
DATABASE_URL=postgresql://localhost:5432/nba_betting

# ============================================================================
# OPTIONAL VARIABLES
# ============================================================================

# The Odds API Key (for additional betting odds sources)
# Get yours at: https://the-odds-api.com
# Required only if using betting market features
THE_ODDS_API_KEY=your_odds_api_key_here

# ============================================================================
# API AUTHENTICATION (OPTIONAL)
# ============================================================================

# Enable JWT authentication for API endpoints
# Set to "true" to require authentication, "false" to allow public access
AUTH_ENABLED=false

# JWT Secret Key (required if AUTH_ENABLED=true)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your_jwt_secret_key_here

# Simple API Key (alternative to JWT)
# Used for X-API-Key header authentication
API_KEY=your_api_key_here

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Frontend URL for CORS (Vercel deployment)
# Example: https://nba-betting-frontend.vercel.app
FRONTEND_URL=http://localhost:3000

# ============================================================================
# MONITORING & ALERTS
# ============================================================================

# Email for error alerts and retraining notifications
ALERT_EMAIL=your_email@example.com

# Slack webhook URL for alerts
# Get from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Pushover push notifications (primary delivery for briefings + scheduler alerts)
# Get yours at: https://pushover.net
PUSHOVER_APP_TOKEN=your_pushover_app_token_here
PUSHOVER_USER_KEY=your_pushover_user_key_here

# ============================================================================
# TRAINING CONFIGURATION
# ============================================================================

# Maximum training time in seconds (default: 7200 = 2 hours)
MAX_TRAINING_TIME=7200

# Minimum days between full retrains (default: 14)
MIN_DAYS_BETWEEN_FULL_RETRAIN=14

# Minimum days between incremental updates (default: 3)
MIN_DAYS_BETWEEN_INCREMENTAL=3

# Performance degradation threshold (default: 0.05 = 5%)
PERFORMANCE_DEGRADATION_THRESHOLD=0.05

# ============================================================================
# ODDS TRACKER CONFIGURATION
# ============================================================================

# Odds update interval in minutes (default: 5)
ODDS_UPDATE_INTERVAL=5

# Odds tracker operating hours (24-hour format, EST)
ODDS_TRACKER_START_HOUR=8
ODDS_TRACKER_END_HOUR=23

# ============================================================================
# PREDICTION CONFIGURATION
# ============================================================================

# Daily predictions run time (hour in 24-hour format, EST)
DAILY_PREDICTIONS_HOUR=9

# Minimum confidence score for bet recommendations (0-100)
MIN_BET_CONFIDENCE=75

# ============================================================================
# LOGGING
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file directory (relative to project root)
LOG_DIR=logs

# ============================================================================
# RAILWAY-SPECIFIC VARIABLES (automatically set by Railway)
# ============================================================================

# PORT - Railway assigns this automatically
# RAILWAY_ENVIRONMENT - "production" or "staging"
# RAILWAY_SERVICE_NAME - Service name in Railway
# RAILWAY_DEPLOYMENT_ID - Unique deployment ID

# ============================================================================
# AGENT INFRASTRUCTURE
# ============================================================================

# Redis URL (auto-provisioned by Railway)
# Used by agent message bus for inter-agent communication
REDIS_URL=redis://localhost:6379/0

# Gemini API Key (for agent LLM reasoning — Gemini 2.0 Flash)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# DEVELOPMENT VARIABLES (local testing only)
# ============================================================================

# Use local SQLite instead of PostgreSQL (for testing)
USE_SQLITE=false

# Local SQLite database path
SQLITE_PATH=nba_betting.db

# Debug mode (verbose logging)
DEBUG=false

# Skip model loading on startup (faster development)
SKIP_MODEL_LOADING=false
